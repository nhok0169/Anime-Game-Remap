@PACKAGE_INIT@

# AGRemapCore links Z3, which is found rather than installed with it: point Z3_DIR (or
#   CMAKE_PREFIX_PATH) at a Z3 install, eg. the one the API Builder makes in cext/z3
include(CMakeFindDependencyMacro)
find_dependency(Z3 CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/AGRemapCoreTargets.cmake")