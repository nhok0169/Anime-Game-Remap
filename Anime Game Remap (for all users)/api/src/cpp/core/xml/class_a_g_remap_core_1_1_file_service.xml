<parameterdescription>
<para>The target file path to resolve </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>relFolder</parametername>
</parameternamelist>
<parameterdescription>
<para>The folder &apos;dstPath&apos; is relative to, if it isn&apos;t already absolute</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>The absolute path for &apos;dstPath&apos; </para>
</simplesect>
</para>
