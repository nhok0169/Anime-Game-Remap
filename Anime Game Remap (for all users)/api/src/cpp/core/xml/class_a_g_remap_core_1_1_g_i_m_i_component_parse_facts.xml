</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">slot</parametername>
</parameternamelist>
<parameterdescription>
<para>The source slot, eg. <computeroutput>C</computeroutput> </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
