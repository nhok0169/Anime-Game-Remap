      </memberdef>
      <memberdef kind="typedef" id="class_a_g_remap_core_1_1_ini_fix_builder_1ae367280bdaa331711bf03470eb03e2d4" prot="public" static="no">
        <type><ref refid="class_a_g_remap_core_1_1_mod_assets" kindref="compound">ModAssets</ref>&lt; std::string, <ref refid="class_a_g_remap_core_1_1_ini_fix_builder_1adcd6dfb15a9abd828cc790e698dd2928" kindref="member">Factory</ref> &gt;</type>
        <definition>using AGRemapCore::IniFixBuilder::ArgsRepo = ModAssets&lt;std::string, Factory&gt;</definition>
