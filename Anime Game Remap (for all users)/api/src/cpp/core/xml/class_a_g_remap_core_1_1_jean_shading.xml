        <definition>void AGRemapCore::JeanShading::liftLowAlpha</definition>
        <argsstring>(TextureFile &amp;texFile)</argsstring>
        <name>liftLowAlpha</name>
        <qualifiedname>AGRemapCore::JeanShading::liftLowAlpha</qualifiedname>
        <param>
