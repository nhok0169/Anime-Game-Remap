        <argsstring>(const std::vector&lt; std::optional&lt; K &gt; &gt; &amp;nonVersionVals, const std::vector&lt; std::optional&lt; Version &gt; &gt; &amp;versionVals, bool errorOnNotFound=true) const</argsstring>
        <name>get</name>
        <qualifiedname>AGRemapCore::ModAssets::get</qualifiedname>
