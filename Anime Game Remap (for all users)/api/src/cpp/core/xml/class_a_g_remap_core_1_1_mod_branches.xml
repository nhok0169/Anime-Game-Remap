        <definition>std::string AGRemapCore::ModBranches::pick</definition>
        <argsstring>(const std::vector&lt; BranchVal &gt; &amp;candidates, const std::string &amp;fallback, const std::optional&lt; Z3Predicate &gt; &amp;query)</argsstring>
        <name>pick</name>
        <qualifiedname>AGRemapCore::ModBranches::pick</qualifiedname>
        <param>
