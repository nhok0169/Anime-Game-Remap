</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>errorOnNotFound</parametername>
</parameternamelist>
<parameterdescription>
<para>Whether to throw when no graph is found. <bold>Default</bold>: <computeroutput>true</computeroutput></para>
