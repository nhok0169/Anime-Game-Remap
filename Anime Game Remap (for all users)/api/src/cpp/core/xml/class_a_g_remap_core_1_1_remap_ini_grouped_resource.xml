</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>isBuilt</parametername>
</parameternamelist>
<parameterdescription>
<para>Whether the grouped resource is ready to be fixed </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
