<parameternamelist>
<parametername>AGRemapCore::SyntaxErr</parametername>
</parameternamelist>
<parameterdescription>
<para>The provided source text cannot be correctly tokenized</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>The list of tokens to the source text </para>
</simplesect>
</para>
