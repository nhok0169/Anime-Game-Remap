        <definition>WWMISections::Bypasses AGRemapCore::WWMISections::bypasses</definition>
        <argsstring>(const IniParseData &amp;data, const std::string &amp;sections, const std::string &amp;overrideList, const std::string &amp;cleanupList, const std::string &amp;modName)</argsstring>
        <name>bypasses</name>
        <qualifiedname>AGRemapCore::WWMISections::bypasses</qualifiedname>
        <param>
          <type>const <ref refid="class_a_g_remap_core_1_1_ini_parse_data" kindref="compound">IniParseData</ref> &amp;</type>
          <declname>data</declname>
        </param>
